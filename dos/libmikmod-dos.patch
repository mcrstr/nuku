--- a/libmikmod/drivers/dos/dosdma.h
+++ b/libmikmod/drivers/dos/dosdma.h
@@ -176,6 +176,17 @@ typedef struct dma_buffer_s {
 	unsigned char channel;		/* The DMA channel */
 } dma_buffer;
 
+/* Nuku DOS build: the host program (Free Pascal go32v2) may move its memory
+   block when the heap grows, and __djgpp_conventional_base is not refreshed
+   then. Recompute the near pointer to the DMA buffer from the current base
+   on every access instead of trusting the cached 'linear' field. */
+#ifdef __DJGPP__
+#include <sys/nearptr.h>
+#define dma_linear(b) ((unsigned char *)((b)->physical - (unsigned long)__djgpp_base_address))
+#else
+#define dma_linear(b) ((b)->linear)
+#endif
+
 /* Allocate a block of memory suitable for using as a DMA buffer */
 extern dma_buffer *dma_allocate(unsigned int channel, unsigned int size);
 /* Deallocate a DMA buffer */
